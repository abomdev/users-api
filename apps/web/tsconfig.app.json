{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    /* bundler es el modo pensado para proyectos que compila Vite: entiende
       imports sin extension y resuelve `exports` de package.json igual que
       Vite en tiempo de ejecucion, asi que tsc y el bundler nunca discrepan. */
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* Exige distinguir `import type` de un import normal. Es lo mismo que
       resolvimos a mano en el backend para los tipos de express: aca el
       compilador lo obliga en lugar de confiar en acordarse. */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"]
}
