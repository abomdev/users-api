# El contexto de build es la RAIZ del monorepo, no la carpeta de cada
# aplicacion: el lockfile de pnpm vive aca arriba y sin el no se puede instalar
# con --frozen-lockfile.
#
# Todo lo que no aparezca en este archivo se envia al daemon de Docker en cada
# build. Ademas de hacerlo lento, cualquier cosa copiada por accidente termina
# dentro de la imagen -- incluidos los secretos.

**/node_modules
**/dist
**/coverage

# NUNCA dentro de la imagen: las credenciales van por variables de entorno
**/.env
**/.env.local
**/.env.*.local

.git
.github
.vscode
.idea
.claude

# El cliente de Prisma se regenera dentro del build
apps/api/src/generated

# Tests y sus configuraciones: no forman parte del artefacto que se despliega
apps/api/test
**/*.spec.ts
**/*.e2e-spec.ts
apps/api/jest.config.js

**/*.log
**/*.tsbuildinfo
*.md
!README.md
