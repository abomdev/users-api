# Entorno de los tests end to end.
#
# Este archivo SI se versiona, a diferencia de .env: no contiene ningun secreto
# real. La base es descartable y el JWT_SECRET solo firma tokens de prueba.
#
# Apunta a una base distinta de la de desarrollo (users_api_test) porque los
# tests borran todas las tablas antes de cada archivo. Si compartieran base, un
# `pnpm test:e2e` te vaciaria los datos con los que estabas probando a mano.

NODE_ENV=test
PORT=3001

DATABASE_URL=postgresql://users_api:postgres_local@localhost:5432/users_api_test?schema=public

JWT_SECRET=secreto-solo-para-tests-no-usar-en-ningun-otro-lado-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7

# Origen del cliente web autorizado por CORS (ver seccion 8 de spec.md)
WEB_ORIGIN=http://localhost:5173
