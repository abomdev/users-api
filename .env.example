# Copiar a .env y completar. El .env NO se versiona.
# La app valida estas variables al arrancar: si falta o es invalida, no levanta.

NODE_ENV=development
PORT=3000

# --- PostgreSQL (los consume docker-compose para crear el contenedor) ---
POSTGRES_USER=users_api
POSTGRES_PASSWORD=postgres_local
POSTGRES_DB=users_api
POSTGRES_PORT=5432

# --- Conexion que usa la aplicacion ---
# Debe coincidir con las credenciales de arriba.
DATABASE_URL=postgresql://users_api:postgres_local@localhost:5432/users_api?schema=public

# --- Autenticacion ---
# Minimo 32 caracteres. Generar uno propio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Vida del access token (regla 9 de la spec)
JWT_ACCESS_TTL=15m

# Vida del refresh token en dias (regla 12 de la spec)
REFRESH_TTL_DAYS=7
